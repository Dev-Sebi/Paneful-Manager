{
  "name": "@agent-hub/web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "tokens": "tsx scripts/generate-tokens.ts",
    "tokens:check": "tsx scripts/generate-tokens.ts --check",
    "prebuild": "pnpm tokens",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e/tsconfig.json",
    "e2e": "playwright test",
    "test": "vitest run",
    "lint": "pnpm lint:tokens",
    "lint:tokens": "tsx scripts/lint-tokens.ts"
  },
  "dependencies": {
    "@agent-hub/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mdi/font": "7.4.47",
    "animate.css": "^4.1.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.30",
    "vue-router": "^5.4.0",
    "vuetify": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.0",
    "jsdom": "^30.1.3",
    "sass-embedded": "^1.98.0",
    "tsx": "^4.23.15",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.2.5"
  }
}
