{
  "$description": "Agent Hub design tokens (W3C DTCG format). Themed tokens are groups with exactly two child tokens: `dark` and `light`. Aliases use the `{group.token}` syntax and must be resolved by the build script.",
  "color": {
    "$type": "color",
    "$extensions": {
      "dev.agenthub.vuetify": {
        "background": "color.bg.canvas",
        "surface": "color.bg.surface",
        "surface-variant": "color.bg.elevated",
        "primary": "color.accent.default",
        "secondary": "color.secondary.default",
        "error": "color.status.error",
        "warning": "color.status.waiting",
        "info": "color.status.working",
        "success": "color.status.success",
        "on-background": "color.fg.primary",
        "on-surface": "color.fg.primary",
        "on-surface-variant": "color.fg.primary",
        "on-primary": "color.fg.on-accent",
        "on-secondary": "color.fg.on-secondary",
        "on-error": "color.fg.on-status",
        "on-warning": "color.fg.on-status",
        "on-info": "color.fg.on-status",
        "on-success": "color.fg.on-status"
      }
    },
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f6f8fa" },
      "100": { "$value": "#eef1f4" },
      "200": { "$value": "#dde2e8" },
      "300": { "$value": "#c3cad3" },
      "400": { "$value": "#9aa4b0" },
      "500": { "$value": "#747f8c" },
      "600": { "$value": "#59636f" },
      "700": { "$value": "#3f4752" },
      "800": { "$value": "#2b313a" },
      "850": { "$value": "#22272e" },
      "900": { "$value": "#1a1e24" },
      "950": { "$value": "#12151a" },
      "1000": { "$value": "#0b0d10" }
    },
    "accent": {
      "100": { "$value": "#dbe7ff" },
      "200": { "$value": "#b6cefe" },
      "300": { "$value": "#8db2fc" },
      "400": { "$value": "#6496f7" },
      "500": { "$value": "#3f7cf0" },
      "600": { "$value": "#2563d9" },
      "700": { "$value": "#1d4fb0" },
      "800": { "$value": "#193f88" },
      "900": { "$value": "#152f63" },
      "default": {
        "$description": "Primary action fill, active tab indicator, selection.",
        "dark": { "$value": "{color.accent.400}" },
        "light": { "$value": "{color.accent.600}" }
      },
      "hover": {
        "dark": { "$value": "{color.accent.300}" },
        "light": { "$value": "{color.accent.700}" }
      },
      "subtle": {
        "$description": "Low-emphasis accent background (selected rows, active tab background).",
        "dark": { "$value": "{color.accent.900}" },
        "light": { "$value": "{color.accent.100}" }
      }
    },
    "red": {
      "300": { "$value": "#ff938a" },
      "400": { "$value": "#f47067" },
      "700": { "$value": "#c42b23" },
      "800": { "$value": "#a3241d" }
    },
    "green": {
      "300": { "$value": "#7ee08f" },
      "400": { "$value": "#57c26b" },
      "700": { "$value": "#1f7a35" },
      "800": { "$value": "#176229" }
    },
    "amber": {
      "300": { "$value": "#f2cc60" },
      "400": { "$value": "#e3b341" },
      "700": { "$value": "#8a5d00" },
      "800": { "$value": "#6f4b00" }
    },
    "cyan": {
      "300": { "$value": "#6fdde5" },
      "400": { "$value": "#39c5cf" },
      "700": { "$value": "#0f7680" },
      "800": { "$value": "#0b5d65" }
    },
    "magenta": {
      "300": { "$value": "#dcb0ff" },
      "400": { "$value": "#c58af9" },
      "700": { "$value": "#8a3fd1" },
      "800": { "$value": "#6f2fb0" }
    },
    "bg": {
      "canvas": {
        "$description": "App background behind panes and tab bars.",
        "dark": { "$value": "{color.neutral.950}" },
        "light": { "$value": "{color.neutral.50}" }
      },
      "surface": {
        "$description": "Panels, tab bar, cards.",
        "dark": { "$value": "{color.neutral.900}" },
        "light": { "$value": "{color.neutral.0}" }
      },
      "elevated": {
        "$description": "Dialogs, menus, tooltips, secondary button fill.",
        "dark": { "$value": "{color.neutral.850}" },
        "light": { "$value": "{color.neutral.100}" }
      },
      "hover": {
        "dark": { "$value": "{color.neutral.800}" },
        "light": { "$value": "{color.neutral.200}" }
      },
      "selected": {
        "dark": { "$value": "{color.accent.subtle.dark}" },
        "light": { "$value": "{color.accent.subtle.light}" }
      },
      "scrim": {
        "$description": "Modal backdrop, applied at 60% opacity.",
        "dark": { "$value": "{color.neutral.1000}" },
        "light": { "$value": "{color.neutral.900}" }
      }
    },
    "fg": {
      "primary": {
        "dark": { "$value": "{color.neutral.100}" },
        "light": { "$value": "{color.neutral.900}" }
      },
      "muted": {
        "dark": { "$value": "{color.neutral.400}" },
        "light": { "$value": "{color.neutral.600}" }
      },
      "disabled": {
        "$description": "Disabled text. Exempt from WCAG contrast requirements.",
        "dark": { "$value": "{color.neutral.600}" },
        "light": { "$value": "{color.neutral.400}" }
      },
      "on-accent": {
        "dark": { "$value": "{color.neutral.1000}" },
        "light": { "$value": "{color.neutral.0}" }
      },
      "on-secondary": {
        "dark": { "$value": "{color.neutral.100}" },
        "light": { "$value": "{color.neutral.900}" }
      },
      "on-danger": {
        "dark": { "$value": "{color.neutral.1000}" },
        "light": { "$value": "{color.neutral.0}" }
      },
      "on-status": {
        "$description": "Text on a solid status fill (Vuetify on-error/on-warning/on-info/on-success).",
        "dark": { "$value": "{color.neutral.1000}" },
        "light": { "$value": "{color.neutral.0}" }
      }
    },
    "secondary": {
      "default": {
        "dark": { "$value": "{color.neutral.700}" },
        "light": { "$value": "{color.neutral.200}" }
      }
    },
    "danger": {
      "default": {
        "dark": { "$value": "{color.red.400}" },
        "light": { "$value": "{color.red.700}" }
      },
      "hover": {
        "dark": { "$value": "{color.red.300}" },
        "light": { "$value": "{color.red.800}" }
      }
    },
    "border": {
      "default": {
        "dark": { "$value": "{color.neutral.700}" },
        "light": { "$value": "{color.neutral.300}" }
      },
      "focus": {
        "$description": "Focus ring. Must keep 3:1 against bg.canvas, bg.surface and bg.elevated.",
        "dark": { "$value": "{color.accent.400}" },
        "light": { "$value": "{color.accent.600}" }
      }
    },
    "status": {
      "working": {
        "dark": { "$value": "{color.accent.400}" },
        "light": { "$value": "{color.accent.600}" }
      },
      "waiting": {
        "dark": { "$value": "{color.amber.400}" },
        "light": { "$value": "{color.amber.700}" }
      },
      "error": {
        "dark": { "$value": "{color.red.400}" },
        "light": { "$value": "{color.red.700}" }
      },
      "idle": {
        "dark": { "$value": "{color.neutral.400}" },
        "light": { "$value": "{color.neutral.600}" }
      },
      "success": {
        "dark": { "$value": "{color.green.400}" },
        "light": { "$value": "{color.green.700}" }
      }
    },
    "terminal": {
      "$description": "xterm.js ITheme. Token names are kebab-case; convert to camelCase for xterm (bright-black -> brightBlack, selection -> selectionBackground, fg -> foreground, bg -> background).",
      "black": { "dark": { "$value": "{color.neutral.800}" }, "light": { "$value": "{color.neutral.900}" } },
      "red": { "dark": { "$value": "{color.red.400}" }, "light": { "$value": "{color.red.700}" } },
      "green": { "dark": { "$value": "{color.green.400}" }, "light": { "$value": "{color.green.700}" } },
      "yellow": { "dark": { "$value": "{color.amber.400}" }, "light": { "$value": "{color.amber.700}" } },
      "blue": { "dark": { "$value": "{color.accent.400}" }, "light": { "$value": "{color.accent.600}" } },
      "magenta": { "dark": { "$value": "{color.magenta.400}" }, "light": { "$value": "{color.magenta.700}" } },
      "cyan": { "dark": { "$value": "{color.cyan.400}" }, "light": { "$value": "{color.cyan.700}" } },
      "white": { "dark": { "$value": "{color.neutral.300}" }, "light": { "$value": "{color.neutral.500}" } },
      "bright-black": { "dark": { "$value": "{color.neutral.500}" }, "light": { "$value": "{color.neutral.600}" } },
      "bright-red": { "dark": { "$value": "{color.red.300}" }, "light": { "$value": "{color.red.800}" } },
      "bright-green": { "dark": { "$value": "{color.green.300}" }, "light": { "$value": "{color.green.800}" } },
      "bright-yellow": { "dark": { "$value": "{color.amber.300}" }, "light": { "$value": "{color.amber.800}" } },
      "bright-blue": { "dark": { "$value": "{color.accent.300}" }, "light": { "$value": "{color.accent.700}" } },
      "bright-magenta": { "dark": { "$value": "{color.magenta.300}" }, "light": { "$value": "{color.magenta.800}" } },
      "bright-cyan": { "dark": { "$value": "{color.cyan.300}" }, "light": { "$value": "{color.cyan.800}" } },
      "bright-white": { "dark": { "$value": "{color.neutral.50}" }, "light": { "$value": "{color.neutral.400}" } },
      "fg": { "dark": { "$value": "{color.neutral.200}" }, "light": { "$value": "{color.neutral.900}" } },
      "bg": { "dark": { "$value": "{color.neutral.950}" }, "light": { "$value": "{color.neutral.0}" } },
      "cursor": { "dark": { "$value": "{color.accent.400}" }, "light": { "$value": "{color.accent.600}" } },
      "selection": { "dark": { "$value": "#3f7cf066" }, "light": { "$value": "#2563d933" } }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base scale. Key = multiplier of 4px.",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "10px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "11px" },
      "sm": { "$value": "12px" },
      "md": { "$value": "13px" },
      "lg": { "$value": "15px" },
      "xl": { "$value": "18px" },
      "2xl": { "$value": "22px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "normal": { "$value": 1.4 },
      "relaxed": { "$value": 1.6 }
    }
  },
  "shadow": {
    "$type": "shadow",
    "0": {
      "dark": { "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" } },
      "light": { "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" } }
    },
    "1": {
      "dark": { "$value": { "color": "#00000066", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
      "light": { "$value": { "color": "#0b0d101f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } }
    },
    "2": {
      "dark": { "$value": { "color": "#00000080", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } },
      "light": { "$value": { "color": "#0b0d1029", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } }
    },
    "3": {
      "dark": { "$value": { "color": "#00000099", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } },
      "light": { "$value": { "color": "#0b0d1033", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "100ms" },
      "normal": { "$value": "160ms" },
      "slow": { "$value": "240ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] }
    }
  },
  "z": {
    "$type": "number",
    "$description": "Stacking layers. overlay/modal/toast sit at or above the Vuetify overlay default (2000).",
    "base": { "$value": 0 },
    "sticky": { "$value": 10 },
    "overlay": { "$value": 2000 },
    "modal": { "$value": 2100 },
    "toast": { "$value": 2200 }
  }
}
