{
  "name": "agent-hub",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-hub/shared build && pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . && pnpm -r --if-present run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter @agent-hub/shared build && pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "e2e": "pnpm --filter @agent-hub/web e2e"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
