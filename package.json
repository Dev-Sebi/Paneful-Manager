{
  "name": "paneful-manager",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @paneful-manager/shared build && pnpm -r --parallel run dev",
    "login-url": "pnpm --silent --filter @paneful-manager/server login-url",
    "build": "pnpm -r run build",
    "lint": "eslint . && pnpm -r --if-present run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter @paneful-manager/shared build && pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "e2e": "pnpm --filter @paneful-manager/web e2e",
    "release:pack": "sh scripts/release-pack.sh"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-config-vuetify": "^4.3.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
