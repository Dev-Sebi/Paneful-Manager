<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by install.sh; @...@ placeholders are replaced at install time. Paneful Manager server (macOS). -->
<!-- Restarting it never touches the tmux sessions (they belong to dev.paneful-manager.tmux). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.paneful-manager</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>@PREFIX@/current/apps/server/dist/index.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@PREFIX@/current</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PANEFUL_MANAGER_PORT</key>
    <string>@PORT@</string>
    <key>XDG_CONFIG_HOME</key>
    <string>@CONFIG_HOME@</string>
    <key>XDG_STATE_HOME</key>
    <string>@STATE_HOME@</string>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>LANG</key>
    <string>@LANG@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/server.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/server.log</string>
</dict>
</plist>
