# Installed by install.sh; @...@ placeholders are replaced at install time.
# Owns the tmux server that runs every Agent Hub session. Stopping it ends all sessions.
[Unit]
Description=Agent Hub tmux server
Documentation=https://github.com/@REPO@

[Service]
Type=forking
Environment="PATH=@PATH@"
Environment="LANG=@LANG@"
ExecStart=@TMUX@ -L agent-hub -f @STATE_DIR@/tmux.conf start-server
ExecStop=@TMUX@ -L agent-hub kill-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
