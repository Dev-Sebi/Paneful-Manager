# Installed by install.sh; @...@ placeholders are replaced at install time.
# Restarting this unit never touches the tmux sessions (they belong to paneful-manager-tmux.service).
# It listens on the sockets of paneful-manager.socket, which keeps the port bound while this unit is down.
[Unit]
Description=Paneful Manager server
Documentation=https://github.com/@REPO@
Requires=paneful-manager.socket
Wants=paneful-manager-tmux.service
After=paneful-manager-tmux.service paneful-manager.socket

[Service]
Type=simple
Environment=NODE_ENV=production
Environment=PANEFUL_MANAGER_PORT=@PORT@
Environment=XDG_CONFIG_HOME=@CONFIG_HOME@
Environment=XDG_STATE_HOME=@STATE_HOME@
Environment="PATH=@PATH@"
Environment="LANG=@LANG@"
WorkingDirectory=@PREFIX@/current
ExecStart=@NODE@ @PREFIX@/current/apps/server/dist/index.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
